{
  "name": "ledgerly",
  "productName": "Ledgerly",
  "version": "1.0.0",
  "description": "Ledgerly \u2014 private, offline personal finance for Windows. Your financial data stays on your computer.",
  "author": "Ledgerly",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist-electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node scripts/run-tests.mjs",
    "icons": "node scripts/make-icons.mjs",
    "start": "electron .",
    "package": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "package:dir": "npm run build && electron-builder --win dir --x64 --publish never",
    "postinstall": "node scripts/setup-electron.mjs"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/archiver": "^6.0.3",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.544.0",
    "papaparse": "^5.5.3",
    "png-to-ico": "^2.1.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.2.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.0"
  }
}
